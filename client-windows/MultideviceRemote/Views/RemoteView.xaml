<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MultideviceRemote.Views.RemoteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Black">
        <!-- Video surface — SIPSorcery render ke sini -->
        <SwapChainPanel x:Name="VideoPanel"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>

        <!-- Overlay toolbar (muncul saat hover) -->
        <StackPanel VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Margin="8"
                    Spacing="4"
                    Opacity="0.8">
            <Button x:Name="DisconnectButton" Content="✕ Putuskan"
                    Style="{StaticResource AccentButtonStyle}"/>
        </StackPanel>

        <!-- Status overlay saat connecting -->
        <StackPanel x:Name="ConnectingOverlay"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
            <TextBlock Text="Menghubungkan…" Foreground="White"
                       HorizontalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>
