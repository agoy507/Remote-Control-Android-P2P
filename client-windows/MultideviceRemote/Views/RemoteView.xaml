<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MultideviceRemote.Views.RemoteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Black">
        <!-- Video surface — SIPSorcery render ke sini via VideoFrameRenderer -->
        <SwapChainPanel x:Name="VideoPanel"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>

        <!-- Overlay toolbar (muncul saat hover / always visible) -->
        <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch"
              Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
              Padding="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status text -->
            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Text="🔴 Tersambung"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"/>

            <!-- Control buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <!-- Home -->
                <Button x:Name="HomeButton" Content="🏠" ToolTipService.ToolTip="Home (H)"
                        Width="36" Height="32" Padding="0"
                        Click="HomeButton_Click"/>
                <!-- Back -->
                <Button x:Name="BackButton" Content="◀" ToolTipService.ToolTip="Back (B)"
                        Width="36" Height="32" Padding="0"
                        Click="BackButton_Click"/>
                <!-- Recents -->
                <Button x:Name="RecentsButton" Content="⧉" ToolTipService.ToolTip="Recents (R)"
                        Width="36" Height="32" Padding="0"
                        Click="RecentsButton_Click"/>

                <Rectangle Width="1" Height="20" Fill="Gray" Margin="4,0"/>

                <!-- Disconnect -->
                <Button x:Name="DisconnectButton" Content="✕ Putuskan"
                        Style="{StaticResource AccentButtonStyle}"
                        Height="32"
                        Click="DisconnectButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Connecting overlay -->
        <StackPanel x:Name="ConnectingOverlay"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="Visible">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
            <TextBlock Text="Menghubungkan…" Foreground="White"
                       HorizontalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}"/>
        </StackPanel>

    </Grid>
</UserControl>
