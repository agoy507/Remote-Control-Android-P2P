# ─── Multidevice Remote — Server Environment Variables ──────────────────────
#
# Production topology:
#   remote.agoy507.my.id  → Cloudflare Tunnel → 127.0.0.1:18081 (Caddy)
#   turn.agoy507.my.id    → 168.110.216.221  (PC B, Oracle)
#
# CARA SETUP:
#   cp .env.example .env
#   # Isi TURN_SECRET dengan secret yang digunakan coturn (dari 17 Nov)
#   docker compose up -d --build

# Secret HMAC bersama antara signaling server & coturn
# Harus identik dengan yang dikonfigurasi di coturn --static-auth-secret
# Generate: openssl rand -hex 32
TURN_SECRET=ganti_dengan_secret_hmac_yang_sama_dengan_coturn

# TTL kredensial TURN dalam detik (default 1 jam)
TURN_TTL_SECONDS=3600

# Opsional: batasi akses ke signaling server hanya dengan token ini
# Kosongkan untuk akses publik
SERVER_API_TOKEN=
