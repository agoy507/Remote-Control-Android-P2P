# Alamat IP publik VPS atau IP LAN host Docker (dipakai oleh coturn & URL ICE)
PUBLIC_HOST=192.168.1.100
PUBLIC_IP=192.168.1.100

# Port WebSocket Signaling di host
SIGNALING_PORT=8080

# Secret HMAC bersama antara Node.js Signaling & coturn (ganti dengan string acak 32+ karakter!)
TURN_SECRET=ganti_dengan_secret_hmac_acak_yang_kuat_minimal_32_karakter
TURN_REALM=kendalip2p.local
TURN_TTL_SECONDS=3600

# Opsional: Token akses untuk membatasi siapa yang boleh terhubung ke server signaling
SERVER_API_TOKEN=
