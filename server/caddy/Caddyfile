# Multidevice Remote — Caddyfile
# Listen di loopback 127.0.0.1:18081 saja.
# Cloudflare Tunnel: remote.agoy507.my.id → tunnel → 127.0.0.1:18081

:18081 {
    # Health check endpoint — jawab 200 OK
    handle /health {
        respond "OK" 200
    }

    # WebSocket signaling — proxy ke container signaling internal
    # FIX: gunakan @websocket matcher agar upgrade header diteruskan dengan benar
    @websocket {
        path /ws
    }
    handle @websocket {
        reverse_proxy signaling:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
        }
    }

    # Tolak semua path lainnya
    handle {
        respond "Not Found" 404
    }
}
